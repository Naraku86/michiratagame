# Cuentas opcionales (Supabase Auth). Sin estas variables el juego funciona igual:
# guardado local, tablero anónimo y modo offline no dependen de ellas.
# Copia este archivo a .env SOLO en tu máquina/servidor; .env está en .gitignore.

# --- Servidor (server/auth.ts) ---
# none (por defecto) | supabase. Si pones supabase y faltan datos, el servidor no arranca (falla cerrado).
MICHI_AUTH_PROVIDER=none
# Sólo el origen del proyecto, sin /auth/v1. Ej.: https://<project-ref>.supabase.co o tu dominio personalizado.
SUPABASE_URL=
# Clave PUBLICABLE (sb_publishable_...) o anon heredada. NUNCA la secreta (sb_secret_...) ni service_role.
SUPABASE_PUBLISHABLE_KEY=
# Tiempo máximo para validar una sesión contra Supabase (500–15000 ms).
MICHI_AUTH_TIMEOUT_MS=5000

# --- Navegador (src/auth.ts, Vite expone sólo VITE_*) ---
# Mismos valores públicos que arriba. Quedan visibles en el JavaScript publicado: por eso sólo la clave publicable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Dirección exacta a la que vuelven OAuth, confirmación y recuperación. Debe ser del mismo dominio del juego
# y estar en Authentication > URL Configuration > Redirect URLs. Por defecto: <origen actual>/
VITE_AUTH_REDIRECT_URL=
