{
  "name": "michiratagame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts server/*.test.ts tools/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --experimental-strip-types server/start.ts",
    "balance": "node --experimental-strip-types tools/balance.ts",
    "package:itch": "node --experimental-strip-types tools/package-itch.ts",
    "prestige:simulate": "node --experimental-strip-types tools/prestige.ts",
    "audit:local": "node --experimental-strip-types tools/audit-cheats.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "@types/node": "^24.0.0"
  },
  "license": "MIT",
  "description": "Un clicker absurdo de Michiratas, hecho con TypeScript, Vite y Node.js.",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Naraku86/michiratagame.git"
  },
  "bugs": {
    "url": "https://github.com/Naraku86/michiratagame/issues"
  }
}
